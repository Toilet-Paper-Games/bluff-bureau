{
  "game": {
    "id": "bluff-bureau",
    "version": "0.2.4",
    "title": "Bluff Bureau"
  },
  "bundle": {
    "manifest": "bundle/manifest.template.json",
    "output": "dist",
    "clean": true,
    "copies": [
      {
        "from": "build/surfaces",
        "to": "."
      },
      {
        "from": "surfaces/host.html",
        "to": "host.html",
        "replacements": {
          "src=\"../src/host.ts\"": "src=\"./host.js\""
        }
      },
      {
        "from": "surfaces/controller.html",
        "to": "controller.html",
        "replacements": {
          "src=\"../src/controller.ts\"": "src=\"./controller.js\""
        }
      },
      {
        "from": "surfaces/spectator.html",
        "to": "spectator.html",
        "replacements": {
          "src=\"../src/spectator.ts\"": "src=\"./spectator.js\""
        }
      },
      {
        "from": "assets/artwork",
        "to": "artwork"
      }
    ]
  }
}
